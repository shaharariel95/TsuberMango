  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-tsuber \"vitest run\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-tsuber \"vitest run\"",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:test": "node scripts/seedTestCenter.js shaharariel95@gmail.com",
    "local:test": "firebase emulators:exec --only auth,firestore --config ../frontend/firebase.json --project tsuberi-mangos-7e449 \"npm run local:test:run\"",
    "local:test:run": "npm run seed:test && concurrently -k -n backend,frontend -c blue,magenta \"cross-env CENTER_ID=test npm run dev\" \"cross-env VITE_USE_EMULATORS=true npm --prefix ../frontend run dev\""
